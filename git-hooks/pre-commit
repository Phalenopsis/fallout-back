#!/bin/bash
# Empêche les commits directs sur main et dev

branch=$(git rev-parse --abbrev-ref HEAD)

if [[ "$branch" == "main" || "$branch" == "dev" ]]; then
  echo "❌ Vous ne pouvez pas committer directement sur la branche '$branch'."
  echo "👉 Veuillez créer une feature branch (ex: feat/ma-fonctionnalite)"
  exit 1
fi

# 2. Vérifie que la branche commence par l’un des préfixes autorisés
if [[ ! "$branch" =~ ^(feat|fix|config|doc)\/.+ ]]; then
  echo "❌ Nom de branche invalide : '$branch'"
  echo "👉 Les branches doivent commencer par : feat/, fix/, config/, doc/"
  echo "   Exemples valides :"
  echo "     feat/ajout-auth"
  echo "     fix/correction-bug-42"
  echo "     config/docker-setup"
  echo "     doc/mise-a-jour-readme"
  exit 1
fi

echo "✔ Nom de branche valide : $branch"

echo "🔍 Lancement des tests unitaires et d'intégration..."
export MAVEN_OPTS="-Dfile.encoding=UTF-8"
./mvnw test -Dtest='*Test,!*E2ETest'
result=$?

if [ $result -ne 0 ]; then
  echo "❌ Certains tests ont échoué. Commit annulé."
  exit 1
else
  echo "✅ Tous les tests unitaires et d'intégration sont passés !"
fi
exit 0
